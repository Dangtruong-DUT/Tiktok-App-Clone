import { View, Button, TextInput, Text } from 'react-native';
import * as ImagePicker from 'expo-image-picker';
import axios from 'axios';
import * as FileSystem from 'expo-file-system';

const API = 'http://10.0.2.2:4000'; // adjust

export default function UploadScreen({ navigation }) {
  const [file, setFile] = useState(null);
  const [title, setTitle] = useState('');

  async function pickVideo() {
    const res = await ImagePicker.launchImageLibraryAsync({ mediaTypes: ImagePicker.MediaTypeOptions.Videos });
    if (!res.cancelled) setFile(res);
  }

  async function upload() {
    if (!file) return alert('Choisis une vidéo');
    const token = await getToken();
    const filename = file.uri.split('/').pop();
    const mime = 'video/mp4'; // approximated; could be file.type

    // get presigned
    const pres = await axios.post(`${API}/videos/presign`, { filename, contentType: mime }, { headers: { Authorization: `Bearer ${token}` }});
    const uploadUrl = pres.data.uploadUrl;
    // read file
    const fileBlob = await FileSystem.readAsStringAsync(file.uri, { encoding: FileSystem.EncodingType.Base64 });
    const binary = atob(fileBlob); // note: environment differences — may need fetch blob method
    // simpler: use fetch to upload
    const fileData = await fetch(file.uri);
    const blob = await fileData.blob();
    await fetch(uploadUrl, { method:'PUT', body: blob, headers: { 'Content-Type': mime }});
    // create record
    await axios.post(`${API}/videos`, { s3Key: pres.data.key, title }, { headers: { Authorization: `Bearer ${token}` }});
    alert('Upload fait, traitement en cours');
    navigation.goBack();
  }

  return (
    <View style={{ padding: 20 }}>
      <Button title="Choisir une vidéo" onPress={pickVideo} />
      {file && <Text>Fichier: {file.uri}</Text>}
      <TextInput placeholder="Titre" value={title} onChangeText={setTitle} style={{ borderWidth:1, marginVertical:10, padding:8 }} />
      <Button title="Uploader" onPress={upload} />
    </View>
  );
}
module.exports = { sequelize, User, Video, Like, Comment };
